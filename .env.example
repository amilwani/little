# Generate with: npx auth secret
AUTH_SECRET=

# Google Cloud OAuth client (Web application). See README.md.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Google file picker, used by teammates to join a shared project. See README.md.
# An API key restricted to the Google Picker API, and your Google Cloud project number.
NEXT_PUBLIC_GOOGLE_API_KEY=
NEXT_PUBLIC_GOOGLE_APP_ID=
